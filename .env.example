# fal.ai — server-only, never exposed to the browser
FAL_KEY=

# Anthropic — optional, only needed for the AI Cinematic Prompt writer in Prompt Builder
ANTHROPIC_API_KEY=

# Website leads — optional, only needed for the Leads page. This is the
# monsta-media-site marketing website's own Neon database URL (a separate
# database from this app's Supabase instance) — read-only here. Not needed
# if that same Neon database is connected to this Vercel project directly
# (Storage tab) — in that case Vercel already provides it as DATABASE_URL
# and this page picks it up automatically.
WEBSITE_LEADS_DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
